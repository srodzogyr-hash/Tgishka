# ==========================================
# КОНФИГУРАЦИЯ TGISHKA (ЛОКАЛЬНЫЙ СЕРВЕР)
# ==========================================

# 1. ОБЯЗАТЕЛЬНО: Токен вашего Telegram бота (от @BotFather)
TG_TOKEN=

# 2. ОПЦИОНАЛЬНО: Порт веб-сервера (по умолчанию 5000, не конфликтует с ChatGPT на 8080)
PORT=5000

# 3. ОПЦИОНАЛЬНО: Ключи Gemini API (через запятую или пробел)
# Примечание: на локальном сервере уже встроен Antigravity (agy), поэтому бот работает даже БЕЗ ключей!
GEMINI_KEYS=

# 4. ОПЦИОНАЛЬНО: Ключ Groq (для быстрого автоответчика)
GROQ_API_KEY=

# 5. ОПЦИОНАЛЬНО: URL базы Firebase Realtime Database
FIREBASE_URL=
